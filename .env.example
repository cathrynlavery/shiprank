# Generate local defaults with `npm run setup:local`.
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
AUTH_URL=http://localhost:3000

# GitHub App OAuth credentials.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_APP_SLUG=shiprank-local

# Optional second OAuth app for full-visibility/private collaborator repo testing.
AUTH_GITHUB_FULL_ID=
AUTH_GITHUB_FULL_SECRET=

# Optional in local development. If unset, ShipRank uses .local-data/shiprank-store.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

CRON_SECRET=
